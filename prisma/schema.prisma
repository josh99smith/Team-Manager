generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Roles: HEAD_COACH | ASSISTANT | POSITION_COACH  (SQLite has no enums)
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("ASSISTANT")
  positionGroup String?
  createdAt     DateTime @default(now())
  tasks         Task[]   @relation("TaskAssigneeUser")
  grades        Grade[]
}

model Team {
  id     String @id @default(cuid())
  name   String
  sport  String @default("Football")
  season String @default("")
}

// Status: ACTIVE | INJURED | ARCHIVED
model Player {
  id             String       @id @default(cuid())
  firstName      String
  lastName       String
  jersey         Int?
  positions      String       @default("") // comma-separated, e.g. "QB,WR"
  heightIn       Int?
  weightLb       Int?
  birthdate      DateTime?
  classYear      String?
  email          String?
  phone          String?
  emergencyName  String?
  emergencyPhone String?
  status         String       @default("ACTIVE")
  notes          String       @default("")
  createdAt      DateTime     @default(now())
  attendance     Attendance[]
  tasks          Task[]       @relation("TaskAssigneePlayer")
  ratings        PlayerRating[]
  ratingHistory  RatingHistory[]
  grades         Grade[]
}

// Type: PRACTICE | GAME | SCRIMMAGE | MEETING | WORKOUT
model Event {
  id           String       @id @default(cuid())
  type         String       @default("PRACTICE")
  title        String       @default("")
  startsAt     DateTime
  endsAt       DateTime?
  location     String       @default("")
  opponent     String?
  notes        String       @default("")
  recurrenceId String? // shared id linking instances of a recurring series
  createdAt    DateTime     @default(now())
  attendance   Attendance[]
  tasks        Task[]
  grades       Grade[]
}

// ---- Phase 2: ratings & grading ----

// Category: Physical | Mental | Ball Skills | Blocking | Defense | Kicking | Intangibles
model AttributeDefinition {
  id       String           @id @default(cuid())
  key      String           @unique // e.g. "speed"
  name     String // e.g. "Speed"
  category String
  sort     Int              @default(0)
  ratings  PlayerRating[]
  history  RatingHistory[]
  weights  PositionWeight[]
}

// Relative weight of an attribute in a position's overall (OVR) formula.
model PositionWeight {
  id          String              @id @default(cuid())
  position    String // e.g. "QB"
  attributeId String
  weight      Int // 0-100, relative
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([position, attributeId])
}

model PlayerRating {
  id          String              @id @default(cuid())
  playerId    String
  attributeId String
  value       Int // 0-99
  isOverride  Boolean             @default(false)
  updatedAt   DateTime            @updatedAt
  player      Player              @relation(fields: [playerId], references: [id], onDelete: Cascade)
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([playerId, attributeId])
}

// Snapshot written whenever a rating changes. attributeId null = OVR snapshot.
model RatingHistory {
  id          String               @id @default(cuid())
  playerId    String
  attributeId String?
  value       Int
  eventId     String?
  reason      String               @default("") // "grade" | "override"
  createdAt   DateTime             @default(now())
  player      Player               @relation(fields: [playerId], references: [id], onDelete: Cascade)
  attribute   AttributeDefinition? @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@index([playerId, attributeId, createdAt])
}

// One grade per player per event per coach.
// categoriesJson: {"Ball Skills": 78, ...}; appliedJson: {"<attributeId>": 2, ...}
model Grade {
  id             String   @id @default(cuid())
  playerId       String
  eventId        String
  coachId        String
  overall        Int? // 0-100 quick grade
  categoriesJson String   @default("{}")
  appliedJson    String   @default("{}")
  notes          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  coach          User     @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@unique([playerId, eventId, coachId])
}

// Status: PRESENT | LATE | EXCUSED | ABSENT
model Attendance {
  id       String @id @default(cuid())
  playerId String
  eventId  String
  status   String @default("PRESENT")
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([playerId, eventId])
}

// Status: OPEN | IN_PROGRESS | DONE
model Task {
  id               String    @id @default(cuid())
  title            String
  description      String    @default("")
  dueDate          DateTime?
  status           String    @default("OPEN")
  assigneeUserId   String?
  assigneePlayerId String?
  eventId          String?
  createdAt        DateTime  @default(now())
  assigneeUser     User?     @relation("TaskAssigneeUser", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  assigneePlayer   Player?   @relation("TaskAssigneePlayer", fields: [assigneePlayerId], references: [id], onDelete: SetNull)
  event            Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
}
