# Postgres connection string — free options: Neon (neon.tech) or Vercel Postgres
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true
# Powers AI photo import (schedule + roster). Get a key at console.anthropic.com.
# Without it, those two import pages show a friendly "not configured" error —
# everything else in the app works fine without this variable set.
ANTHROPIC_API_KEY="sk-ant-..."
