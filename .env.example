# Postgres connection string — free options: Neon (neon.tech) or Vercel Postgres
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true
# Powers AI photo import (schedule + roster). Get a key at console.anthropic.com.
# Optional here — the head coach can instead paste a key on the Settings page
# after signing in, which takes priority over this variable. Without either,
# those two import pages show a friendly "not configured" error; everything
# else in the app works fine.
ANTHROPIC_API_KEY="sk-ant-..."
